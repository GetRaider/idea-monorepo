{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -b -v",
    "dev": "tsc -b -v --watch",
    "clean": "rm -rf dist && rm -rf .turbo",
    "clean:hard": "pnpm run clean && rm -rf node_modules",
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind.preset.ts",
    "./assets/brands/take-and-do.svg": "./assets/brands/take-and-do.svg",
    "./components/*": "./src/components/*/index.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/styled-components": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-collapsible": "catalog:",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "catalog:",
    "@radix-ui/themes": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "sonner": "^2.0.7",
    "styled-components": "catalog:",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
