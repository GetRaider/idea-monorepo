      "checkConstraints": {
        "habits_title_length_check": {
          "name": "habits_title_length_check",
          "value": "char_length(\"habits\".\"title\") between 1 and 80"
        },
        "habits_description_length_check": {
          "name": "habits_description_length_check",
          "value": "\"habits\".\"description\" is null or char_length(\"habits\".\"description\") <= 500"
        },
        "habits_why_length_check": {
          "name": "habits_why_length_check",
          "value": "\"habits\".\"why\" is null or char_length(\"habits\".\"why\") between 1 and 500"
        },
        "habits_minimum_action_length_check": {
          "name": "habits_minimum_action_length_check",
          "value": "\"habits\".\"minimum_action\" is null or char_length(\"habits\".\"minimum_action\") between 1 and 200"
        },
        "habits_trigger_length_check": {
          "name": "habits_trigger_length_check",
          "value": "\"habits\".\"trigger\" is null or char_length(\"habits\".\"trigger\") between 1 and 200"
        },
        "habits_duration_check": {
          "name": "habits_duration_check",
          "value": "\"habits\".\"estimated_duration_minutes\" is null or \"habits\".\"estimated_duration_minutes\" between 1 and 180"
        },
        "habits_weekdays_check": {
          "name": "habits_weekdays_check",
          "value": "\"habits\".\"weekdays\" is null or (\n        cardinality(\"habits\".\"weekdays\") between 1 and 7\n        and \"habits\".\"weekdays\" <@ array[1,2,3,4,5,6,7]::smallint[]\n      )"
        },
        "habits_complete_plan_check": {
          "name": "habits_complete_plan_check",
          "value": "\"habits\".\"status\" = 'backlog' or (\n        \"habits\".\"why\" is not null\n        and \"habits\".\"minimum_action\" is not null\n        and \"habits\".\"trigger\" is not null\n        and \"habits\".\"weekdays\" is not null\n        and \"habits\".\"estimated_duration_minutes\" is not null\n      )"
        }
      },
