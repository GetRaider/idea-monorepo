      "updated": 1788198072196,
      "link": null,
      "locked": false,
      "id": "scale-body",
      "type": "text",
      "x": -347,
      "y": 2075,
      "width": 900,
      "height": 100,
      "text": "Traffic (100 avg / 300 peak RPS, 1M rows) → one Nest + pooled Postgres. Do not shard.\n\nCache: Better Auth cookieCache + TanStack Query. No Redis v0.\nCDN: Next static only. LB: host default. Skip k8s / replicas until p95 or 99.9% fails.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Traffic (100 avg / 300 peak RPS, 1M rows) → one Nest + pooled Postgres. Do not shard.\n\nCache: Better Auth cookieCache + TanStack Query. No Redis v0.\nCDN: Next static only. LB: host default. Skip k8s / replicas until p95 or 99.9% fails.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
