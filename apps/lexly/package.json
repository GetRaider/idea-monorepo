{
  "name": "lexly",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "clean": "rm -rf .next && rm -rf .turbo",
    "clean:hard": "pnpm run clean && rm -rf node_modules",
    "build": "next build --turbopack",
    "dev": "next dev --turbopack",
    "prod": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hallelx/youtube-transcript": "^0.2.0",
    "@repo/api": "workspace:*",
    "@repo/shared": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.11.0",
    "next": "catalog:",
    "pg": "^8.13.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.4.27",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "husky": "^9.1.7",
    "postcss": "^8.5.8",
    "prettier": "catalog:",
    "pretty-quick": "^4.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --max-warnings=0"
  }
