# Todex API
PORT=8091
API_BASE_URL=http://localhost:8091
WEB_BASE_URL=http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5434/todex?sslmode=disable
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Google OAuth (identity only: openid email profile — no calendar scopes)
