      "seed": 1133,
      "version": 1,
      "versionNonce": 1134,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788198072196,
      "link": null,
      "locked": false,
      "id": "rel-body",
      "type": "text",
      "x": -347,
      "y": 2235,
      "width": 900,
      "height": 140,
      "text": "Retries: Google 429 backoff. Jobs idempotent on googleEventId.\nRate limit: Nest throttle on /v1 writes + /api/auth.\nMonitoring: @nestjs/observe + request id.\nFailover: managed PG PITR + second API instance if 99.9% actually hurts.\nCalendar dual-write: LWW on etag (edge case #1).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Retries: Google 429 backoff. Jobs idempotent on googleEventId.\nRate limit: Nest throttle on /v1 writes + /api/auth.\nMonitoring: @nestjs/observe + request id.\nFailover: managed PG PITR + second API instance if 99.9% actually hurts.\nCalendar dual-write: LWW on etag (edge case #1).",
      "autoResize": true,
      "lineHeight": 1.25
    }
